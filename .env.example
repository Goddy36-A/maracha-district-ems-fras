# Copy this file to .env and fill in real values. Never commit the real .env file.

# Django
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# Database (leave unset to use local SQLite for development)
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://miu_ems_user:changeme@localhost:5432/miu_ems

# Time zone
TIME_ZONE=UTC

# Email (used for password reset + notifications)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@miu.ac.ug

# Production-only (see config/settings/production.py)
CSRF_TRUSTED_ORIGINS=https://ems.miu.ac.ug

# Uploads
MAX_UPLOAD_SIZE_MB=10
